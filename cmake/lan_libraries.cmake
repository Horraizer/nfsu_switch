# Isolated two-human LAN experiment. The ordinary RaceRun never selects it.
# OS socket lifetime and datagrams live behind the narrow LanSocket boundary.
add_library(nfsu_lan_socket src/lan_socket.cpp)
target_include_directories(nfsu_lan_socket PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(nfsu_lan_socket PUBLIC cxx_std_17)
nfsu_enable_warnings(nfsu_lan_socket)
add_library(nfsu_lan src/lan_protocol.cpp src/lan_link.cpp src/lan_race.cpp)
target_link_libraries(nfsu_lan PUBLIC nfsu_race_session nfsu_car_assets nfsu_lan_socket)
target_compile_features(nfsu_lan PUBLIC cxx_std_17)
nfsu_enable_warnings(nfsu_lan)
add_library(nfsu_lan_scene src/lan_scene.cpp)
target_link_libraries(nfsu_lan_scene PUBLIC nfsu_lan nfsu_race_run nfsu_race_hud nfsu_posix_file_system)
target_link_libraries(nfsu_lan_scene PRIVATE nfsu_frontend)
nfsu_enable_warnings(nfsu_lan_scene)
if(WIN32)
    target_link_libraries(nfsu_lan_socket PUBLIC ws2_32)
endif()
if(NINTENDO_SWITCH)
    target_compile_definitions(nfsu_lan_socket PRIVATE __SWITCH__=1)
    set_target_properties(nfsu_lan_socket nfsu_lan nfsu_lan_scene PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS ON)
elseif(NFSU_BUILD_TESTS)
    add_executable(nfsu_lan_probe tools/lan_probe.cpp)
    target_link_libraries(nfsu_lan_probe PRIVATE nfsu_lan_scene nfsu_arg_path nfsu_sha256)
    nfsu_enable_warnings(nfsu_lan_probe)
    add_executable(nfsu_lan_tests tests/lan_tests.cpp)
    target_link_libraries(nfsu_lan_tests PRIVATE nfsu_lan)
    nfsu_enable_warnings(nfsu_lan_tests)
    add_test(NAME nfsu_lan_tests COMMAND nfsu_lan_tests)
    set_tests_properties(nfsu_lan_tests PROPERTIES TIMEOUT 60)
endif()
