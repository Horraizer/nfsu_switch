cmake_minimum_required(VERSION 3.20)
foreach(key SOURCE WORK GENERATOR CXX PYTHON)
    if(NOT DEFINED ${key})
        message(FATAL_ERROR "${key} is required")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(targets nfsu_crash_camera_tests nfsu_start_crowd_check nfsu_race_skid_tests nfsu_car_shadow_projection_tests)
foreach(enabled ON OFF)
    set(case_dir "${WORK}/${suffix}-${enabled}")
    if(EXISTS "${case_dir}")
        message(FATAL_ERROR "fresh configure output already exists")
    endif()
    file(MAKE_DIRECTORY "${case_dir}/.cmake/api/v1/query")
    file(WRITE "${case_dir}/.cmake/api/v1/query/codemodel-v2" "")
    # Deliberately omit BUILD_TESTING: the first documented configure must
    # create the same targets as an existing cache, without a second pass.
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE}" -B "${case_dir}"
        -G "${GENERATOR}" "-DCMAKE_CXX_COMPILER=${CXX}"
        "-DPython3_EXECUTABLE=${PYTHON}" "-DNFSU_BUILD_TESTS=${enabled}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "fresh ${enabled} configure failed: ${output}\n${errors}")
    endif()
    file(GLOB replies "${case_dir}/.cmake/api/v1/reply/codemodel-v2-*.json")
    list(LENGTH replies reply_count)
    if(NOT reply_count EQUAL 1)
        message(FATAL_ERROR "fresh configure did not produce one codemodel")
    endif()
    list(GET replies 0 reply)
    file(READ "${reply}" model)
    string(JSON count LENGTH "${model}" configurations 0 targets)
    math(EXPR last "${count} - 1")
    set(names)
    foreach(i RANGE 0 ${last})
        string(JSON name GET "${model}" configurations 0 targets ${i} name)
        list(APPEND names "${name}")
    endforeach()
    foreach(target IN LISTS targets)
        list(FIND names "${target}" position)
        if(enabled AND position LESS 0)
            message(FATAL_ERROR "first configure omitted ${target}")
        elseif(NOT enabled AND NOT position LESS 0)
            message(FATAL_ERROR "disabled tests still created ${target}")
        endif()
    endforeach()
endforeach()
message(STATUS "fresh first-configure test targets obey NFSU_BUILD_TESTS ON/OFF")
