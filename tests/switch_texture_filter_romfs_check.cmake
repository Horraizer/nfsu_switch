# v2 is a bounded diagnostic fixture; never substitute the gameplay replay.
include(${CMAKE_CURRENT_LIST_DIR}/switch_deko_romfs_check.cmake)
file(READ "${REFERENCES}" references)
string(REGEX MATCH "kTextureFilterFixtureHash =[^\"]*\"([A-F0-9]+)\"" matched "${references}")
string(TOLOWER "${CMAKE_MATCH_1}" expected)
string(LENGTH "${expected}" hash_length)
file(SHA256 "${REPLAY}" digest)
if(NOT hash_length EQUAL 64 OR NOT digest STREQUAL expected)
    message(FATAL_ERROR "texture_filter_v2.txt differs from its pinned fixture")
endif()
file(READ "${REPLAY}" replay HEX)
string(FIND "${romfs}" "${replay}" found)
string(HEX "texture_filter_v2.txt" filename)
string(FIND "${romfs}" "${filename}" named)
if(found LESS 0 OR named LESS 0)
    message(FATAL_ERROR "v2 fixture missing from diagnostic RomFS")
endif()
foreach(stage IN ITEMS textured_opaque.frag car_shaded.vert car_shaded.frag sky.vert sky.frag)
    file(READ "${SHADERS}/${stage}.dksh" blob HEX)
    string(FIND "${romfs}" "${blob}" found)
    if(found LESS 0)
        message(FATAL_ERROR "${stage}.dksh missing from diagnostic RomFS")
    endif()
endforeach()
file(READ "${ELF}" elf_hex HEX)
string(HEX "${BUILD_TAG}" tag_hex)
string(FIND "${elf_hex}" "${tag_hex}" tag_position)
if(BUILD_TAG STREQUAL "" OR BUILD_TAG STREQUAL "local" OR tag_position LESS 0)
    message(FATAL_ERROR "diagnostic ELF is missing its configured build tag")
endif()
message(STATUS "diagnostic NRO contains all eight shaders, the pinned v2 fixture and build tag ${BUILD_TAG}")
