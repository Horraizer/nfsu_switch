include(${CMAKE_CURRENT_LIST_DIR}/switch_deko_romfs_check.cmake)
file(SHA256 "${REPLAY}" digest)
if(NOT digest STREQUAL "d4d5172161a897fd4a746dc58e9c35ce235739658267e56f9e7bf401a9247515")
    message(FATAL_ERROR "event1.txt differs from the desktop recording")
endif()
file(READ "${REPLAY}" replay HEX)
string(FIND "${romfs}" "${replay}" found)
if(found LESS 0)
    message(FATAL_ERROR "event1.txt missing from race RomFS")
endif()
message(STATUS "race NRO contains the exact pinned event1 recording")
file(SHA256 "${PERFORMANCE_REPLAY}" performance_digest)
if(NOT performance_digest STREQUAL "23f1d49a8feabae738728c872b6a1af77e5c45f6c2fbfd31d2c7b380779b20af")
    message(FATAL_ERROR "performance1.txt differs from its pinned recording")
endif()
file(READ "${PERFORMANCE_REPLAY}" performance_replay HEX)
string(FIND "${romfs}" "${performance_replay}" performance_found)
if(performance_found LESS 0)
    message(FATAL_ERROR "performance1.txt missing from race RomFS")
endif()
message(STATUS "race NRO contains the exact performance1 recording")

file(READ "${ELF}" elf_hex HEX)
string(HEX "${BUILD_TAG}" tag_hex)
string(FIND "${elf_hex}" "${tag_hex}" tag_position)
if(BUILD_TAG STREQUAL "" OR BUILD_TAG STREQUAL "local" OR tag_position LESS 0)
    message(FATAL_ERROR "race ELF is missing its configured build tag")
endif()
message(STATUS "race build tag: ${BUILD_TAG}")
