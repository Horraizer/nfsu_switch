include(${CMAKE_CURRENT_LIST_DIR}/switch_deko_romfs_check.cmake)
file(SHA256 "${REPLAY}" digest)
if(NOT digest STREQUAL "ced29ab7d90f0861afe2c0b604d0eddfb4f769beb067944f8e9c7db0b892e0ac")
    message(FATAL_ERROR "event1.txt differs from the desktop recording")
endif()
file(READ "${REPLAY}" replay HEX)
string(FIND "${romfs}" "${replay}" found)
if(found LESS 0)
    message(FATAL_ERROR "event1.txt missing from race RomFS")
endif()
message(STATUS "race NRO contains the exact pinned event1 recording")
