cmake_minimum_required(VERSION 3.20)
foreach(name RACE WORK)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "${name} required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}/retail")
file(WRITE "${WORK}/existing.txt" "KEEP\n")
file(WRITE "${WORK}/invalid.txt" "NFSU_RACE_INPUT 1\n0 0 0\n")
function(refuse label expected)
    execute_process(COMMAND "${RACE}" ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE out ERROR_VARIABLE err WORKING_DIRECTORY "${WORK}")
    if(NOT status EQUAL 1 OR NOT err MATCHES "error:.*${expected}")
        message(FATAL_ERROR "${label}: status ${status}\n${out}\n${err}")
    endif()
endfunction()
refuse(empty "choose one input mode")
refuse(missing "missing option value" --root)
refuse(unknown "unknown option" --bad x)
refuse(modes "choose one input mode" --root retail --live --input invalid.txt)
refuse(frames "requires --out" --root retail --input invalid.txt --frames 1)
refuse(frame_range "frame step out of range" --root retail --input invalid.txt --frames 0)
refuse(overwrite "output already exists" --root retail --generate existing.txt)
refuse(retail_write "outside the retail tree" --root retail --generate retail/recording.txt)
refuse(bad_input "invalid race input" --root retail --input invalid.txt)
refuse(missing_assets "event 1 missing" --root retail --generate recording.txt)
file(READ "${WORK}/existing.txt" contents)
if(NOT contents STREQUAL "KEEP\n" OR EXISTS "${WORK}/retail/recording.txt" OR EXISTS "${WORK}/recording.txt")
    message(FATAL_ERROR "a failed command wrote an output")
endif()
message(STATUS "race command guards passed")
