# #237: shared tuned preset in the race; fresh evidence on every invocation.
cmake_minimum_required(VERSION 3.20)
foreach(name IN ITEMS PYTHON SOURCE WORK RACE RUN_TESTS LOADER_TESTS MODE ROOT)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "${name} required")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${ROOT}")
    message(FATAL_ERROR "retail root is not a directory: ${ROOT}")
endif()
set(root "${ROOT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(work "${WORK}/${MODE}-${suffix}")
file(MAKE_DIRECTORY "${work}")
if(MODE STREQUAL "replay")
    set(command "${PYTHON}" "${SOURCE}/tools/race_replay_check.py"
        --exe "${RACE}" --root "${root}" --out "${work}/frames" --tuned --check-driver)
elseif(MODE STREQUAL "draws")
    set(command "${RUN_TESTS}" "${SOURCE}/tests/recordings/event1.txt" "${root}" --full-draws --tuned)
elseif(MODE STREQUAL "loader")
    set(command "${LOADER_TESTS}" "${root}" --tuned)
else()
    message(FATAL_ERROR "unknown tuned race test mode")
endif()
execute_process(COMMAND "${PYTHON}" "${SOURCE}/tools/frame_budget_evidence.py"
    "${root}" "${work}/evidence" run -- ${command}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
    "${work}/evidence/before.json" "${work}/evidence/after.json" RESULT_VARIABLE changed)
if(NOT changed EQUAL 0)
    message(FATAL_ERROR "retail manifest differs or is missing: ${work}")
endif()
file(READ "${work}/evidence/stdout.txt" child)
if(NOT result EQUAL 0 OR NOT child MATCHES "PASS")
    message(FATAL_ERROR "tuned race ${MODE}: exit ${result}: ${output} ${errors} ${child}")
endif()
message(STATUS "tuned race ${MODE}: manifests match; evidence ${work}")
message("${child}")
