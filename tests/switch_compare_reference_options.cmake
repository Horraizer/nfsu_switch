if(NOT DEFINED SOURCE OR NOT EXISTS "${SOURCE}")
    message(FATAL_ERROR "switch compare reference options: source is missing")
endif()

file(READ "${SOURCE}" source_text)
string(REGEX REPLACE "//[^\\n]*" "" source_without_comments "${source_text}")
if(NOT source_without_comments MATCHES "const[ \t\r\n]+nfsu::RenderOptions[ \t\r\n]+options[ \t\r\n]*=[ \t\r\n]*nfsu::stock_view_default_options\\(\\)[ \t\r\n]*;")
    message(FATAL_ERROR "switch compare reference options: options must be initialized exactly from stock_view_default_options()")
endif()
if(source_without_comments MATCHES "options[ \t\r\n]*\\.[A-Za-z_][A-Za-z0-9_]*[ \t\r\n]*=[^=]")
    message(FATAL_ERROR "switch compare reference options: options must not be modified after initialization")
endif()
if(NOT source_without_comments MATCHES "render_stock_frame\\(stock, options, error\\)")
    message(FATAL_ERROR "switch compare reference options: shared options must render the CPU reference")
endif()
if(NOT source_without_comments MATCHES "record_car_commands\\(stock.scene, options,")
    message(FATAL_ERROR "switch compare reference options: shared options must record the GPU commands")
endif()

message(STATUS "switch compare reference options: CPU and GPU use the stock viewer defaults")
