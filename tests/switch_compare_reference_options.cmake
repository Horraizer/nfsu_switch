if(NOT DEFINED SOURCE OR NOT EXISTS "${SOURCE}")
    message(FATAL_ERROR "switch compare reference options: source is missing")
endif()

function(check_source candidate result_name failure_name)
    string(REGEX REPLACE "//[^\n]*" "" source_without_comments "${candidate}")
    set(failure "")
    if(NOT source_without_comments MATCHES "const[ \t\r\n]+nfsu::RenderOptions[ \t\r\n]+options[ \t\r\n]*=[ \t\r\n]*nfsu::stock_view_default_options\\(\\)[ \t\r\n]*;")
        set(failure "options must be initialized exactly from stock_view_default_options()")
    elseif(source_without_comments MATCHES "options[ \t\r\n]*\\.[A-Za-z_][A-Za-z0-9_]*[ \t\r\n]*=[^=]")
        set(failure "options must not be modified after initialization")
    elseif(NOT source_without_comments MATCHES "render_stock_frame\\(stock, options, error\\)")
        set(failure "shared options must render the CPU reference")
    elseif(NOT source_without_comments MATCHES "record_car_commands\\(stock.scene, options,")
        set(failure "shared options must record the GPU commands")
    endif()

    if(failure STREQUAL "")
        set(${result_name} TRUE PARENT_SCOPE)
    else()
        set(${result_name} FALSE PARENT_SCOPE)
    endif()
    set(${failure_name} "${failure}" PARENT_SCOPE)
endfunction()

function(expect_killed label candidate expected_failure)
    check_source("${candidate}" passed failure)
    if(passed OR NOT failure STREQUAL expected_failure)
        message(FATAL_ERROR "switch compare reference options self-test ${label}: expected KILLED (${expected_failure}), got PASS (${failure})")
    endif()
    message(STATUS "switch compare reference options self-test ${label}: KILLED (${failure})")
endfunction()

function(expect_pass label candidate)
    check_source("${candidate}" passed failure)
    if(NOT passed)
        message(FATAL_ERROR "switch compare reference options self-test ${label}: expected PASS, got KILLED (${failure})")
    endif()
    message(STATUS "switch compare reference options self-test ${label}: PASS")
endfunction()

file(READ "${SOURCE}" source_text)
check_source("${source_text}" source_passes source_failure)
if(NOT source_passes)
    message(FATAL_ERROR "switch compare reference options: ${source_failure}")
endif()

set(mutant "${source_text}")
string(REPLACE "const nfsu::RenderOptions options = nfsu::stock_view_default_options();" "nfsu::RenderOptions options; // formerly stock_view_default_options()" mutant "${mutant}")
expect_killed(m2 "${mutant}" "options must be initialized exactly from stock_view_default_options()")

set(mutant "${source_text}")
string(REPLACE "const nfsu::RenderOptions options = nfsu::stock_view_default_options();" "nfsu::RenderOptions options = nfsu::stock_view_default_options();\n    options.material_state = nfsu::MaterialStateMode::off;" mutant "${mutant}")
expect_killed(m3 "${mutant}" "options must be initialized exactly from stock_view_default_options()")

set(mutant "${source_text}")
string(REPLACE "render_stock_frame(stock, options, error)" "// if (!nfsu::render_stock_frame(stock, options, error)) return false;\n    render_stock_frame(stock, nfsu::RenderOptions{}, error)" mutant "${mutant}")
expect_killed(m22 "${mutant}" "shared options must render the CPU reference")

set(mutant "${source_text}")
string(REPLACE "record_car_commands(stock.scene, options," "// record_car_commands(stock.scene, options,\n    record_car_commands(stock.scene, nfsu::RenderOptions{}," mutant "${mutant}")
expect_killed(m23 "${mutant}" "shared options must record the GPU commands")

set(mutant "${source_text}")
string(REPLACE "    const nfsu::RenderOptions options = nfsu::stock_view_default_options();" "    // Stock viewer defaults (retail material state).\n    const nfsu::RenderOptions options = nfsu::stock_view_default_options();" mutant "${mutant}")
expect_pass(m21b "${mutant}")

message(STATUS "switch compare reference options: CPU and GPU use the stock viewer defaults")
