string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(output "${WORK}/unique-ui-${run_id}")
file(MAKE_DIRECTORY "${WORK}")
if(EXISTS "${output}")
    message(FATAL_ERROR "Unique UI output already exists")
endif()
execute_process(COMMAND "${APP}" "${ROOT}" "${output}" unique-pages
    RESULT_VARIABLE result OUTPUT_VARIABLE text ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT errors STREQUAL "" OR
   NOT text MATCHES "PASS dedicated unique reward pages, confirmation, ownership and native reward voices")
    message(FATAL_ERROR "Unique UI check failed: ${result}\n${text}\n${errors}")
endif()
foreach(name IN ITEMS reward-7 choose-7 confirm-7 reward-15 choose-15 confirm-15 reward-26 choose-26 confirm-26)
    if(NOT EXISTS "${output}/${name}.ppm")
        message(FATAL_ERROR "Unique UI did not write ${name}")
    endif()
    file(SIZE "${output}/${name}.ppm" bytes)
    if(bytes LESS 1000)
        message(FATAL_ERROR "Unique UI wrote an empty ${name}")
    endif()
endforeach()
message(STATUS "${text}")
