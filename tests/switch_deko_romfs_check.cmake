# File evidence only: NRO/ELF checks, then every offline blob in its RomFS.
include(${CMAKE_CURRENT_LIST_DIR}/switch_nro_check.cmake)
file(READ "${NRO}" hex HEX)
nfsu_le("${hex}" 24 4 image)
math(EXPR field "${image} + 40")
nfsu_le("${hex}" ${field} 8 romfs_offset)
math(EXPR field "${image} + 48")
nfsu_le("${hex}" ${field} 8 romfs_size)
file(SIZE "${NRO}" file_size)
math(EXPR start "${image} + ${romfs_offset}")
math(EXPR end "${start} + ${romfs_size}")
if(romfs_offset LESS 56 OR romfs_size LESS 80 OR end GREATER file_size)
    message(FATAL_ERROR "deko3d NRO has no bounded RomFS section")
endif()
math(EXPR start_hex "${start} * 2")
math(EXPR size_hex "${romfs_size} * 2")
string(SUBSTRING "${hex}" ${start_hex} ${size_hex} romfs)
foreach(stage IN ITEMS placed.vert textured.frag fallback.frag)
    file(READ "${SHADERS}/${stage}.dksh" blob HEX)
    string(LENGTH "${blob}" size)
    if(size LESS 48)
        message(FATAL_ERROR "${stage}.dksh is empty or truncated")
    endif()
    string(FIND "${romfs}" "${blob}" found)
    if(found LESS 0)
        message(FATAL_ERROR "${stage}.dksh bytes missing from packaged RomFS")
    endif()
endforeach()
message(STATUS "deko3d NRO RomFS contains all three checked offline shaders")
