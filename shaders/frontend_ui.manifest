format 1
program frontend_ui

stage kind=vertex source=frontend_ui.vert.glsl
stage kind=fragment source=frontend_ui.frag.glsl

# PreparedTrackMesh::vertices uploaded as they are: one interleaved buffer
# of nfsu::TrackVertex, which carries no normal.
buffer index=0 stride=24 struct=nfsu::TrackVertex header=nfsu/track.h
attribute location=0 name=position type=vec3 format=float32x3 buffer=0 offset=0 members=px,py,pz
attribute location=1 name=color type=vec4 format=unorm8x4 buffer=0 offset=12 members=color
attribute location=2 name=texcoord type=vec2 format=float32x2 buffer=0 offset=16 members=u,v

varying location=1 name=color type=vec4 interpolation=smooth
varying location=2 name=texcoord type=vec2 interpolation=smooth

block name=Frame binding=0 stages=vertex size=112
member block=Frame name=eye type=vec4 offset=0
member block=Frame name=right type=vec4 offset=16
member block=Frame name=up type=vec4 offset=32
member block=Frame name=forward type=vec4 offset=48
member block=Frame name=projection type=vec4 offset=64
member block=Frame name=light type=vec4 offset=80
member block=Frame name=options type=uvec4 offset=96

# The placed instance's TrackTransform: rows 0..2 from `linear`, row 3 from
# `translation`.
block name=Instance binding=1 stages=vertex size=64
member block=Instance name=rows type=vec4[4] offset=0

texture name=baseTexture binding=0 stage=fragment type=sampler2D filter=nearest wrap=repeat


output location=0 name=color type=vec4 format=rgba8

variant name=opaque alpha_test=always blend=off depth_test=always depth_write=off color_write=rgb cull=none
variant name=alpha_tested alpha_test=greater alpha_ref=170 blend=off depth_test=always depth_write=off color_write=rgb cull=none
variant name=source_over alpha_test=always blend=on blend_src=src_alpha blend_dst=one_minus_src_alpha blend_op=add depth_test=always depth_write=off color_write=rgb cull=none
variant name=additive alpha_test=always blend=on blend_src=src_alpha blend_dst=one blend_op=add depth_test=always depth_write=off color_write=rgb cull=none
variant name=alpha_tested_source_over alpha_test=greater alpha_ref=170 blend=on blend_src=src_alpha blend_dst=one_minus_src_alpha blend_op=add depth_test=always depth_write=off color_write=rgb cull=none
variant name=alpha_tested_additive alpha_test=greater alpha_ref=170 blend=on blend_src=src_alpha blend_dst=one blend_op=add depth_test=always depth_write=off color_write=rgb cull=none
