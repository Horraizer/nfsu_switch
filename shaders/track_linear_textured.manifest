# Linear diffuse candidate; legacy uses track_textured.manifest.
# Interface manifest: the track path's textured draw.
#
# One TrackDrawList entry whose group's binding is resolved, drawn by
# render_track_draw_list (src/track_render.cpp). Retail texture-info bytes
# +85/+86 select the alpha test and blend; the world-effect branch disables
# depth writes for a blended draw. Record kinds:
# docs/SHADER_PIPELINE.md.

format 1
program track_linear_textured

stage kind=vertex source=placed_headlight.vert.glsl
stage kind=fragment source=textured_opaque.frag.glsl

# PreparedTrackMesh::vertices uploaded as they are: one interleaved buffer
# of nfsu::TrackVertex, which carries no normal.
buffer index=0 stride=24 struct=nfsu::TrackVertex header=nfsu/track.h
attribute location=0 name=position type=vec3 format=float32x3 buffer=0 offset=0 members=px,py,pz
attribute location=1 name=color type=vec4 format=unorm8x4 buffer=0 offset=12 members=color
attribute location=2 name=texcoord type=vec2 format=float32x2 buffer=0 offset=16 members=u,v

varying location=0 name=world type=vec3 interpolation=smooth
varying location=1 name=color type=vec4 interpolation=smooth
varying location=2 name=texcoord type=vec2 interpolation=smooth
varying location=3 name=headlight type=vec3 interpolation=smooth

block name=Frame binding=0 stages=vertex,fragment size=112
member block=Frame name=eye type=vec4 offset=0
member block=Frame name=right type=vec4 offset=16
member block=Frame name=up type=vec4 offset=32
member block=Frame name=forward type=vec4 offset=48
member block=Frame name=projection type=vec4 offset=64
member block=Frame name=light type=vec4 offset=80
member block=Frame name=options type=uvec4 offset=96

# The placed instance's TrackTransform: rows 0..2 from `linear`, row 3 from
# `translation`.
block name=Instance binding=1 stages=vertex size=64
member block=Instance name=rows type=vec4[4] offset=0

block name=Material binding=2 stages=fragment size=208
member block=Material name=fallback type=vec4 offset=0
member block=Material name=alpha type=vec4 offset=16
member block=Material name=environment_min type=vec4 offset=32
member block=Material name=environment_range type=vec4 offset=48
member block=Material name=environment_color type=vec4 offset=64
member block=Material name=surface_diffuse_min type=vec4 offset=80
member block=Material name=surface_diffuse_range type=vec4 offset=96
member block=Material name=surface_specular_min type=vec4 offset=112
member block=Material name=surface_specular_range type=vec4 offset=128
member block=Material name=surface_environment_min type=vec4 offset=144
member block=Material name=surface_environment_range type=vec4 offset=160
member block=Material name=surface_gates type=vec4 offset=176
member block=Material name=uv_animation type=vec4 offset=192

texture name=baseTexture binding=0 stage=fragment type=sampler2D filter=linear wrap=repeat

texture name=reflectionTexture binding=1 stage=fragment type=sampler2D filter=linear wrap=clamp_to_edge

output location=0 name=color type=vec4 format=rgba8

variant name=opaque alpha_test=always blend=off depth_test=less_equal depth_write=on color_write=rgb cull=none
variant name=alpha_tested alpha_test=greater alpha_ref=170 blend=off depth_test=less_equal depth_write=on color_write=rgb cull=none
variant name=source_over alpha_test=always blend=on blend_src=src_alpha blend_dst=one_minus_src_alpha blend_op=add depth_test=less_equal depth_write=off color_write=rgb cull=none
variant name=additive alpha_test=always blend=on blend_src=src_alpha blend_dst=one blend_op=add depth_test=less_equal depth_write=off color_write=rgb cull=none
variant name=alpha_tested_source_over alpha_test=greater alpha_ref=170 blend=on blend_src=src_alpha blend_dst=one_minus_src_alpha blend_op=add depth_test=less_equal depth_write=off color_write=rgb cull=none
variant name=alpha_tested_additive alpha_test=greater alpha_ref=170 blend=on blend_src=src_alpha blend_dst=one blend_op=add depth_test=less_equal depth_write=off color_write=rgb cull=none

block name=Headlight binding=4 stages=vertex size=112
member block=Headlight name=eye type=vec4 offset=0
member block=Headlight name=right type=vec4 offset=16
member block=Headlight name=up type=vec4 offset=32
member block=Headlight name=forward type=vec4 offset=48
member block=Headlight name=projection type=vec4 offset=64
member block=Headlight name=light type=vec4 offset=80
member block=Headlight name=options type=uvec4 offset=96
texture name=headlightTexture binding=2 stage=fragment type=sampler2D filter=linear wrap=clamp_to_edge
